printConfigInfo()
{
    local section="${1}"
    local subsection="${2}ConfigInfo"

    if ! is_cliclient_reachable
    then
        printf "N/A\n"
        return
    fi

    local config="$(/usr/local/bin/cliclient GetModemConfigState -g RequestData.${section})"
    if [[ "${config}" == "" ]]
    then
        printf "N/A\n"
        return
    fi
    
    local subconfig="$(/usr/local/bin/cliclient GetModemConfigState -g RequestData.${section}.${subsection})"
    if [[ "${subconfig}" == "" ]]
    then
        printf "N/A\n"
        return
    fi

    subconfig="$(remove_newlines "${subconfig}")"

    if [[ "$(echo ${subconfig} | sed 's/[{ }]//g')" == "" ]]
    then
        printf "N/A\n"
        return
    fi

    printf "Id="
    id="$(json_get_value "${subconfig}" "Id")"
    [[ -z "$id" || "${id}" == "null" ]] && printf "N/A" || printf "${id}"

    printf "; LastUpdated="
    lastupdate="$(json_get_value "${subconfig}" "SecondsSinceLastUpdate")"
    if [[ "${lastupdate}" == "" || "${lastupdate}" == "null" || "$(is_number "${lastupdate}")" != "0" ]]
    then
        printf "N/A\n"
        return
    fi
    local exitcode="0"
    lastupdateTime="$(($(date +%s) - $lastupdate))"
    exitcode="$?"
    [[ "${exitcode}" != "0" ]] && printf "N/A\n" || printf "$(date -d @"${lastupdateTime}")\n"
    return
}
