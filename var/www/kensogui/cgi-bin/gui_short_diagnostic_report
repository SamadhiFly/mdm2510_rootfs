        ntcserial=""
        ntccode=""
        ntcversion=""
        ntchwid=""
        modemtypename=""
        persistentStorage=""
        ntcsigvalid=""
        pkcertvalid=""
        ethstate=""
        ethmsg=""
        wifistate=""
        wifimsg=""
        satstate=""
        satmsg=""
        swstate=""
        swmsg=""
        swdownloadmsg=""
        demodstate=""
        demodmsg=""
        swcurrent=""
        buildtag=""
        if ! is_cliclient_reachable; then return; fi

        deviceInfoData=$(/usr/local/bin/cliclient GetDeviceInformation)
        ntcserial=$(get_json_value "${deviceInfoData}" "RequestData.Hardware.SerialNumber")
        extserial=$(get_json_value "${deviceInfoData}" "RequestData.Hardware.ExtendedSerialNumber")
        ntccode=$(get_json_value "${deviceInfoData}" "RequestData.Hardware.IdCode")
        ntcversion=$(get_json_value "${deviceInfoData}" "RequestData.Hardware.HardwareVersion")
        ntchwid=$(get_json_value "${deviceInfoData}" "RequestData.Hardware.HardwareId")
        modemtypename=$(get_json_value "${deviceInfoData}" "RequestData.Hardware.ModemType")
        persistentStorage=$(get_json_value "${deviceInfoData}" "RequestData.Hardware.PersistentStorage")
        ntcsigvalid=$(get_json_value "${deviceInfoData}" "RequestData.Authentication.ConfigSignatureValid")
        pkcertvalid=$(get_json_value "${deviceInfoData}" "RequestData.Authentication.CertificateValid")
        swcurrent=$(get_json_value "${deviceInfoData}" "RequestData.Software.CurrentVersion")

