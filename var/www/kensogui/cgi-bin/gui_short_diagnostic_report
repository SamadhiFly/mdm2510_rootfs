#!/bin/sh

source /usr/local/bin/ntc_functions

get_json_value()
{
        echo $1 | jq -r .$2
}

split_sr() {
        tmpsrM=""
        tmpsrD=""
        [[ "$1" == "" ]] && return
        #9090000
        # assumes non-empty argument
        len=$(expr length $1)
        tmpsrM=`expr "$1" / 1000000 `
        tempD=`expr "$1" - "$tmpsrM" \* 1000000 `
        lenD=$(expr length $tempD)
        nrzeros=`expr 6 - "$lenD" `
        zeros=0000000000
        tmpsrD=$(expr substr "$zeros" 1 $nrzeros)"$tempD"
}

read_pt_config() {
        support_pol=1
        activebeam=""
        ptpref="N/A"
        ptgenmode="N/A"
        ptfreq="N/A"
        ptpol="N/A"
        ptsr="N/A"
        proporbpos="N/A"
        propweflag="N/A"
        proppolskew="N/A"
        proplatvar="N/A"
        pt2genmode="N/A"
        pt2freq="N/A"
        pt2pol="N/A"
        pt2sr="N/A"
        mobgxtfile="N/A"
        mobbeamname="N/A"
        mobcost="N/A"
        mobexclusionzones="N/A"
        ODU=""
        if ! is_cliclient_reachable; then return; fi
        activebeamData=$(/usr/local/bin/cliclient GetActiveBeam)
        activebeam=$(echo $activebeamData | jq .RequestData.ActiveBeamId)
        if [ "$activebeam" != "null" ]
        then
            beamDataJson=$(/usr/local/bin/cliclient GetBeamData $activebeam)
            ptpref=$(get_json_value "${beamDataJson}" "RequestData.DefaultPointingCarrier")
            ptgenmode=$(get_json_value "${beamDataJson}" "RequestData.PointingCarrier1.Carrier.TSMode")
            ptfreq=$(get_json_value "${beamDataJson}" "RequestData.PointingCarrier1.Carrier.Freq")
            ptpol=$(get_json_value "${beamDataJson}" "RequestData.PointingCarrier1.Carrier.Polarization")
            ptsr=$(get_json_value "${beamDataJson}" "RequestData.PointingCarrier1.Carrier.SymbolRate")
            proporbpos=$(get_json_value "${beamDataJson}" "RequestData.OrbitalDegrees")
            propweflag=$(get_json_value "${beamDataJson}" "RequestData.Hemisphere")
            proppolskew=$(get_json_value "${beamDataJson}" "RequestData.PolarizationSkew")
            proplatvar=$(get_json_value "${beamDataJson}" "RequestData.SatLatitudeVariance")
            pt2genmode=$(get_json_value "${beamDataJson}" "RequestData.PointingCarrier2.Carrier.TSMode")
            pt2freq=$(get_json_value "${beamDataJson}" "RequestData.PointingCarrier2.Carrier.Freq")
            pt2pol=$(get_json_value "${beamDataJson}" "RequestData.PointingCarrier2.Carrier.Polarization")
            pt2sr=$(get_json_value "${beamDataJson}" "RequestData.PointingCarrier2.Carrier.SymbolRate")
            mobgxtfile=$(get_json_value "${beamDataJson}" "RequestData.GxtFileName")
            mobbeamname=$(get_json_value "${beamDataJson}" "RequestData.BeamName")
            mobcost=$(get_json_value "${beamDataJson}" "RequestData.Cost")
            mobexclusionzones=$(get_json_value "${beamDataJson}" "RequestData.ExclusionZones")
        fi
        ODU=$(/usr/local/bin/cliclient GetODUInformation -g RequestData.ODUInformation)
}

