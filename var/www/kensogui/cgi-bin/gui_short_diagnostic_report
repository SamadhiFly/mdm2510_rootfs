        ipaddr=$(get_json_value "${ethernetInterfaceData}" "RequestData.MgmtAddr.Address")
        prefix=$(get_json_value "${ethernetInterfaceData}" "RequestData.MgmtAddr.Prefix")
        ethaddr=$(get_json_value "${ethernetInterfaceData}" "RequestData.MAC")
}

