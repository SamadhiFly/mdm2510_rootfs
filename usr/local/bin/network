#!/bin/sh
#set -e -x

. /usr/local/bin/parse_var_state_cfg.sh
parse_routercontroller_supported
parse_tellinet_on_addin_board

if [ "${tellinet_on_addin_board}" -eq 1 ]; then
  # All main-board network configuration is now statically done in the init_routerboard script.
  # The same approach should be taken for "[ ${CFG_routercontroller_supported}" -eq 1 ]" in general.
  return;
fi

get_netconfig() {
  ethmgmtipaddr=`sed -n "s/^ipaddr=\(.*\)$/\1/p" /var/state/cfg`
  ethmgmtnetmask=`sed -n "s/^netmask=\(.*\)$/\1/p" /var/state/cfg`

  if [ -n "$ethmgmtipaddr" ]; then
    if ! /usr/local/bin/check_eth_subnet "$ethmgmtipaddr" "$ethmgmtnetmask"
    then
      fac_ipaddr=`sed -n "s/^fac_ipaddr=\(.*\)$/\1/p" /var/state/cfg`
      fac_netmask=`sed -n "s/^fac_netmask=\(.*\)$/\1/p" /var/state/cfg`
      ethmgmtipaddr=${fac_ipaddr:=192.168.1.1}
      ethmgmtnetmask=${fac_netmask:=255.255.255.0}
    fi
  fi

  if [ -n "$ethmgmtipaddr" ]; then
    ethmgmtprefix=`ipcalc -sp $ethmgmtipaddr $ethmgmtnetmask | sed -n "s/PREFIX=\(.*\)/\1/p"`
  fi
}

start_network() {
  ethnetwork=`ipcalc -sn ${gateway}/${prefix} | sed -n "s/NETWORK=\(.*\)/\1/p"`
  # setup network configuration for normal state
  ip -4 addr flush dev eth0
  ip -6 addr flush dev eth0 scope global
  ip -6 addr flush dev eth0 scope site

  # always support management IP address on eth0
  if [ "${CFG_routercontroller_supported}" -ne 1 ]; then
      if [ -n "$ethmgmtipaddr" ]; then
          ip -4 addr add ${ethmgmtipaddr}/${ethmgmtprefix} dev eth0
      fi
  fi

  # Ready. Enable IP forwarding, proxy ARP and allow proxy ARP for a non-local route.
  /sbin/sysctl -w net.ipv4.conf.all.forwarding=1
  /sbin/sysctl -w net.ipv6.conf.all.forwarding=1
}

apply_mtu() {
    # the modem MTU is set by the ReturnLinkManager in the modem_controller. It is different based on return technology.
    # if mtu is 0, it means that the MTU field in the protobuf msg (received by modemcontroller from tcs) is NOT filled in.
    # In that case we use all the default MTU's of 1500 Bytes for backward compatibility.
    # For the internal interfaces (such as tun2), it was decided to always use an MTU of 1650. See https://confluence.newtec.eu/display/TS/TLD+DSW+Configurable+MTU.
    if [ "${mtu}" -eq "0" ]; then
        ip link set tun2 mtu 1500
        mtu=1500
    else 
        ip link set tun2 mtu 1650
        mtu=1650
    fi
    logger -t $0 -p daemon.debug "MTU for tun interfaces was set to ${mtu}."
}

# Main
if [ $# -lt 3 ]; then
  echo "usage: network <filename> <version> <mtu>"
  exit 1
fi

filename=$1
version=$2

# maximum transmission unit
mtu=$3

get_netconfig

#debug 

start_network
apply_mtu

logger -t $0 -p daemon.info "$filename version $version applied."

exit 0
