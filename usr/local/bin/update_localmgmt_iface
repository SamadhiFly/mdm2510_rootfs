#!/bin/sh
#set -e -x

VERBOSE=

if [ $# -lt 2 ]; then
  echo "usage: $0 <oldMgmtAddress> <oldMgmtNetmask> [<newMgmtIpAddr> <newMgmtNetmask>]"
  exit 1
fi

. /usr/local/bin/parse_var_state_cfg.sh
. /usr/local/bin/ifcfg_local_mgmt.sh

oldMgmtIpAddr=$1
oldMgmtNetmask=$2
oldMgmtPrefix=`ipcalc -sp $oldMgmtIpAddr $oldMgmtNetmask | sed -n "s/PREFIX=\(.*\)/\1/p"`

newMgmtIpAddr=$ipaddr
newMgmtPrefix=$prefix
if [ $# -eq 4 ]; then
    newMgmtIpAddr=$3
    newMgmtNetmask=$4
    newMgmtPrefix=`ipcalc -sp $newMgmtIpAddr $newMgmtNetmask | sed -n "s/PREFIX=\(.*\)/\1/p"`
fi

crnt=`ip addr show dev ${LM_PHYS_IF} | sed -n 's~.*inet \([0-9\.]*/[0-9]*\).*~\1~p' | head -n 1`
crntIpAddr=${crnt%/*}
crntPrefix=${crnt#*/}

logger -t $0 -p daemon.info "update_localmgmt_iface old:$oldMgmtIpAddr/$oldMgmtPrefix new:$newMgmtIpAddr/$newMgmtPrefix"

[ ! -z "$VERBOSE" ] && logger -t $0 -p daemon.info "update_localmgmt_iface crnt: $crntIpAddr/$crntPrefix"
[ ! -z "$VERBOSE" ] && logger -t $0 -p daemon.info "update_localmgmt_iface if: ${LM_PHYS_IF}"

if [ $crntIpAddr != $newMgmtIpAddr -o $crntPrefix != $newMgmtPrefix ]; then
    logger -t $0 -p daemon.info "update_localmgmt_iface ${LM_PHYS_IF}"
    ip -4 addr flush dev ${LM_PHYS_IF} 
    ip -4 addr add $newMgmtIpAddr/$newMgmtPrefix dev ${LM_PHYS_IF}
fi

iptables -S | grep "$oldMgmtIpAddr" | while read -r line; do
    [ ! -z "$VERBOSE" ] && echo ${line//-A/-D}
    echo ${line//-A/-D} | xargs iptables
    [ ! -z "$VERBOSE" ] && echo $line | sed -n "s~$oldMgmtIpAddr~$newMgmtIpAddr~p"
    echo $line | sed -n "s~$oldMgmtIpAddr~$newMgmtIpAddr~p" | xargs iptables
done

HOSTS="/etc/hosts"
if [ -f $HOSTS ]; then
    sed -i "s~$oldMgmtIpAddr~$newMgmtIpAddr~" $HOSTS 
fi

TELLISHAPE_HOSTS="/etc/tellishape_config/hosts"
if [ -f $TELLISHAPE_HOSTS ]; then
    sed -i "s~$oldMgmtIpAddr~$newMgmtIpAddr~" $TELLISHAPE_HOSTS
fi

DNSMASQ_CONF="/etc/dnsmasq/dnsmasq.conf"
if [ -f $DNSMASQ_CONF ]; then
    sed -i "s~$oldMgmtIpAddr~$newMgmtIpAddr~" $DNSMASQ_CONF 
fi

