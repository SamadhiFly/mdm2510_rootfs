#!/bin/sh
#set -e -x

. /usr/local/bin/parse_var_state_cfg.sh
parse_routercontroller_supported

configure_vlan_tun_itf() {
  if [ $is_vlan -eq "0" ]; then
    tun_itf="tunvl${itf_nr}"
  else
    tun_itf="tunvl${itf_nr}_${vlan_id}"
  fi

  ip -6 addr flush dev ${tun_itf}
  ip -6 addr add ${tun_addr}/128 dev ${tun_itf}
  #Also remove IPv4 route, so we can recreate it later.
  ip route del default table ${table}

  #Recreate routes, because these were deleted when we flushed the interface's address.
  ip -6 route add default dev ${tun_itf} table ${table}
  ip route add default dev ${tun_itf} table ${table}
}

apply_mtu() {
    if [ -n "${mtu}" -a "${mtu}" -gt "1760" ]; then
        logger -t $0 -p daemon.error "Requested MTU was bigger than 1760! Setting maximum MTU size on ${tun_itf} to 1760!!"
        mtu=1760
    fi

    # the modem MTU is set by the ReturnLinkManager in the modem_controller. It is different based on return technology.
    # if mtu is 0, it means that the MTU field in the protobuf msg (received by modemcontroller from tcs) is NOT filled in.
    # In that case we use all the default MTU's of 1500 Bytes for backward compatibility.
    if [ "${mtu}" -eq "0" ]; then
        ip link set ${tun_itf} mtu 1500
        mtu=1500
    else
        ip link set ${tun_itf} mtu ${mtu}
    fi
    logger -t $0 -p daemon.debug "MTU was set to ${mtu}."
}

# Main
if [ $# -lt 8 ]; then
  echo "usage: configure_vlan_tun <filename> <version>"
  echo "               <eth itf> <is_vlan> <vlan id>"
  echo "               <tunnel address> <routing table>"
  echo "	       <mtu>"
  exit 1
fi

filename=$1
version=$2

itf_nr=$3
is_vlan=$4
vlan_id=$5

tun_addr=$6

table=$7
mtu=$8

if [ "${CFG_routercontroller_supported}" -eq 1 ]; then
    # ip6 termination has moved to router board
    echo "script skipped because routercontroller is supported"
    exit 0
fi

configure_vlan_tun_itf
apply_mtu

logger -t $0 -p daemon.info "$filename version $version applied."

exit 0
