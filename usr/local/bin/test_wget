#!/bin/sh

# This script is very similar to test_dns: more information can be found there

htmlfile="/tmp/html..$$"
retval=1 #default error

if [ -z "$1" ]
then
    echo "Usage: ./test_wget url upstream_dns_server tun_bind_addr"
    return $retval
fi

/usr/local/bin/test_conn_state
retval2=$?

if [ "$retval2" != 0 ]; then
        return $retval2
fi

url=$1
dns_server=$2
tun_addr=$3

#what proxy to use? set as environment variable
#but the real answer is "no proxy"
#modemipaddr=`ip addr show dev modem | sed -n 's/.*inet \([0-9\.]*\).*/\1/p'`
#export http_proxy="http://$modemipaddr:9202"

# start dns server to resolve url, more info in test_dns
/usr/sbin/dnsmasq --interface=lo --bind-interfaces --server=${dns_server}@${tun_addr} --pid-file=/var/state/test_pid_wget

#get the page
#remark: redirect stdout and stderr to /devsize/null to shut it up
if [ "$tun_addr" != "" ]
then
   wget --timeout=20 --tries=1 --bind-address=$tun_addr -O ${htmlfile} -q $url > /dev/null 2>&1
fi

#test whether the page was received correctly (size of the page not zero)
size=$(du ${htmlfile} | sed 's/\([0-9]*\)\(.*\)/\1/') 2>/dev/null

if [ "$size" != 0 -a "$size" != "" ]
then
    retval=0 #success
fi

rm ${htmlfile}
kill `cat /var/state/test_pid_wget`
rm /var/state/test_pid_wget

return $retval
