#!/bin/sh

HEXFILE="$1"
GPIONUM=229
GPIOSYSFS=/sys/class/gpio/gpio229
SPIDEV=/dev/spidev0.0

if [ -z "$HEXFILE" ]; then
	echo "usage: %0 FIRMWAREFILE" >&2
	exit 1
fi

if [ ! -d "$GPIOSYSFS" ]; then
	echo "$GPIONUM" > /sys/class/gpio/export
fi

echo "toggle power" >&2
echo out > "$GPIOSYSFS"/direction || exit 1
echo 0 > "$GPIOSYSFS"/value || exit 1
sleep 1
echo 1 > "$GPIOSYSFS"/value || exit 1

fwavr8 -v -d "$SPIDEV" crc "$HEXFILE" && exit 0
fwavr8 -v -d "$SPIDEV" write "$HEXFILE" && exit 0
echo "$0 $HEXFILE: failed" >&2
exit 1
