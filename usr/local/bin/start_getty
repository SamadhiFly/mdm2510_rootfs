#!/bin/sh

# This script is called from inittab and starts/respawns getty if needed:
#    - booted with silent=1 (console is '' in kernel param list) -> getty should not be started at all
#    - not booted with silent=1 -> start getty to accept serial connections and restart getty if it terminates

#store original args for getty because they will be overwritten below
oriGettyArgs=$*

args=`cat /proc/cmdline`
for arg in $args
do
    set -- `echo $arg | tr '=' ' '`
    if [ "$1" = "console" ]
    then
        if [ $2 != "" ]
        then
            while [ true ]
            do
                /sbin/getty $oriGettyArgs
                sleep 1
            done
        fi
        break
    fi
done
