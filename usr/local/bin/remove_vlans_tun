#!/bin/sh
#set -e -x

. /usr/local/bin/parse_var_state_cfg.sh
parse_routercontroller_supported

remove_all_vlans_tun() {
  x=0
  logger -t $0 -p daemon.info "debug: removing vlans."
  while [ $x -lt "$num_vlans" ]; do
    eval is_vlan="\$is_vlan$x"
    eval vlan_id="\$vlan$x"
    eval itf_nr="\$itf$x"
    eval table="\$table$x"

    if [ $is_vlan -ne 0 ]; then
      tun_vlan="tunvl${itf_nr}_${vlan_id}"
    else
      tun_vlan="tunvl${itf_nr}"
    fi
    logger -t $0 -p daemon.info "debug: removing vlan tun interface ${tun_vlan}"

    # Remove routing table and rule associated with this vlan
    ip rule del fwmark ${table} table ${table}
    ip route flush table ${table}
    ip -6 rule del fwmark ${table} table ${table}
    ip -6 route flush table ${table}

    /usr/local/sbin/tunctl -d ${tun_vlan}
    x=$(( $x + 1 ))
  done
}


# Main
if [ $# -lt 3 ]; then
  echo "usage: network <filename> <version>"
  echo "               <num_vlans> [<itf_nr> <is_vlan> <vlan_id> <routing table>]*"
  exit 1
fi

filename=$1
version=$2
num_vlans=$3

if [ "${CFG_routercontroller_supported}" -eq 1 ]; then
    # ip6 termination has moved to router board
    echo "script skipped because routercontroller is supported"
    exit 0
fi

x=0
while [ $x -lt "$num_vlans" ]; do
  eval itf${x}=\"${4}\"
  eval is_vlan${x}=\"${5}\"
  eval vlan${x}=\"${6}\"
  eval table${x}=\"${7}\"
  shift 4
  x=$(( $x + 1 ))
done

remove_all_vlans_tun

logger -t $0 -p daemon.info "$filename version $version applied."

exit 0

