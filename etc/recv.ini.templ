[recipient]
user_name=%USER_NAME%
user_key=%USER_KEY%

[shell]
login=none
interface_address=sig_demod
popups_allowed=0

[watchdog]
activate=1
max_memory_usage=26000000

[mail]

[logging]

[locations]
prefetching_cache_directory=/var/spool/receiving/pushed_data
log_file=|syslog
license_file=/etc/license.ini

[etcp_compression]
capturing_compression=1
http_compression=1

[http_prefetching]
http_prefetching_cache_size=5000000
http_prefetching_cache_lifetime=90
extended_cache_lifetime=0
http_prefetching_memory_cache=1


[proxy_excludes]

[etcp_connection_control_client]
connect_initial_timeout=10000
activate_congestion_control=1
check_server_connection_timeout=0
nr_of_tcp_connections=1

[internal_tcp]
activate=1
interface=tun0
virtual_ip_address=%VIRTUAL_ADDRESS%
tunnel_ip_address=%TUNNEL_ADDRESS%
execute_script=/usr/local/bin/tun_route
rcv_buffer_size=16384

[transparent_capturing]
activate=1
http_prefetching_port_range=50000-60999

[etcp_dscp_forwarding]
activate=1
dscp_control_data=%DSCP_CONTROL_DATA%

[etcp_dscp_priority]

[etcp_parameters]
authentication=1
max_send_data_rate=%MAX_SEND_RATE%
max_receive_data_rate=%MAX_RECV_RATE%
continuous_server_connection=21600
etcp_send_protocol=1

