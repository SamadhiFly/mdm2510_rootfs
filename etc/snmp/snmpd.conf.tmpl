agentAddress udp:161
agentAddress udp6:161
###############################################################################
#
#  ACCESS CONTROL
#
###############################################################################

# Mappings between community strings and security names
#           security name   source mask     community id
com2sec     ro         default         public
com2sec6    ro6        default         public
com2sec     rw         default         private
com2sec6    rw6        default         private

# Mappings between security names and group names
#       group name      security model      security name
group   ro_grp          v2c                 ro
group   ro_grp6         v2c                 ro6
group   limited_grp     v2c                 rw
group   limited_grp6    v2c                 rw6

# View definitions
#       view name       included/excluded   subtree
view    basic_view      included            .1.3.6.1.2.1.1
view    basic_view      excluded            .1.3.6.1.2.1.1.8
view    basic_view      excluded            .1.3.6.1.2.1.1.9
# Newtec Terminal  MIB
view    basic_view      included            .1.3.6.1.4.1.5835.5.2.10300

# Access control directives
#       group name      context     model   level   match       read            write       notify
access  ro_grp          ""          any     noauth  exact       basic_view      none        none
access  ro_grp6         ""          any     noauth  exact       basic_view      none        none
access  limited_grp     ""          any     noauth  exact       basic_view      basic_view  none
access  limited_grp6    ""          any     noauth  exact       basic_view      basic_view  none

###############################################################################
#
#  AgentX support
#
###############################################################################
master agentx
agentXTimeout 600
#agentXPingInterval 15

###############################################################################
#
#  "Pass-through" MIB extension command
#
###############################################################################
#
# Support for official Eth MIB (http://www.alvestrand.no/objectid/1.3.6.1.2.1.2.html)
# is disabled and deprecated. If you want to enable it, uncomment the following two lines.
# By default, proprietary Eth table as defined in Newtec MIB should be used.

#view    basic_view      included            .1.3.6.1.2.1.2
#pass .1.3.6.1.2.1.2  /usr/local/bin/snmp-client-interfaces.sh
